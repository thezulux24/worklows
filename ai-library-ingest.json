            "parameters": {
                "jsCode": "const source = $('Verify Signature').first().json;\nconst text = source.texto || '';\nconst regex = /https?:\\/\\/[^\\s<>\"')\\]]+/g;\nconst rawMatches = text.match(regex) || [];\nconst cleaned = rawMatches.map(function (u) { return u.replace(/[.,;:!?]+$/, ''); });\nconst uniqueLinks = Array.from(new Set(cleaned));\n\nreturn [{\n  json: {\n    webhookId: source.webhookId,\n    chatId: source.chatId,\n    autor: source.autor,\n    texto: source.texto,\n    ts: source.ts,\n    links: uniqueLinks\n  }\n}];"
