        {
            "parameters": {
                "jsCode": "const crypto = require('crypto');\nconst webhookItem = $('Roam Webhook').first();\nconst headers = (webhookItem.json && webhookItem.json.headers) || {};\nconst rawBodyBase64 = webhookItem.binary && webhookItem.binary.data && webhookItem.binary.data.data;\nconst rawBody = rawBodyBase64 ? Buffer.from(rawBodyBase64, 'base64').toString('utf8') : '';\n\nconst secretRow = $json;\nconst rawSecret = secretRow.value || '';\nconst secretB64 = rawSecret.indexOf('whsec_') === 0 ? rawSecret.slice(6) : rawSecret;\nconst keyBuffer = Buffer.from(secretB64, 'base64');\n\nconst webhookId = headers['webhook-id'] || '';\nconst webhookTimestamp = headers['webhook-timestamp'] || '';\nconst webhookSignatureHeader = headers['webhook-signature'] || '';\n\nconst signedContent = webhookId + '.' + webhookTimestamp + '.' + rawBody;\nconst expectedSig = crypto.createHmac('sha256', keyBuffer).update(signedContent, 'utf8').digest('base64');\n\nconst providedEntries = webhookSignatureHeader.split(' ').map(function (s) { return s.trim(); }).filter(Boolean);\nlet signatureValid = false;\nfor (let i = 0; i < providedEntries.length; i++) {\n  const parts = providedEntries[i].split(',');\n  if (parts.length === 2 && parts[0] === 'v1') {\n    const provided = parts[1];\n    try {\n      const providedBuf = Buffer.from(provided);\n      const expectedBuf = Buffer.from(expectedSig);\n      if (providedBuf.length === expectedBuf.length && crypto.timingSafeEqual(providedBuf, expectedBuf)) {\n        signatureValid = true;\n        break;\n      }\n    } catch (e) {}\n  }\n}\n\nlet parsedBody = {};\ntry { parsedBody = JSON.parse(rawBody); } catch (e) { parsedBody = {}; }\nconst data = parsedBody.data || {};\nconst sender = data.sender || {};\n\nconst rawTs = data.timestamp;\nconst tsLooksIso = typeof rawTs === 'string' && /^\\d{4}-/.test(rawTs);\nconst normalizedTs = (rawTs === undefined || rawTs === null || rawTs === '')\n  ? ''\n  : (tsLooksIso ? rawTs : new Date(Number(rawTs) / 1000).toISOString());\n\nreturn [{\n  json: {\n    signatureValid: signatureValid,\n    webhookId: webhookId,\n    chatId: data.chatId || '',\n    version: data.version,\n    contentType: data.contentType || '',\n    userType: data.userType || '',\n    autor: sender.name || data.userId || '',\n    texto: data.text || '',\n    ts: normalizedTs\n  }\n}];"
            },
