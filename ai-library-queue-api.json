            "parameters": {
                "jsCode": "const row = $('Find Oldest Pending').first().json;\nlet links = [];\ntry {\n  const parsed = JSON.parse(row.links || '[]');\n  if (Array.isArray(parsed)) links = parsed;\n} catch (e) {\n  links = [];\n}\nreturn [{\n  json: {\n    item: {\n      id: String(row.id),\n      autor: row.autor,\n      texto: row.texto,\n      links: links,\n      ts: row.ts,\n      estado: 'processing',\n      error: row.error,\n      intento: (row.intento || 0) + 1\n    }\n  }\n}];"
            },
